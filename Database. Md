6. Database Triggers, Views & RPC Functions (Otomasi Backend)
Untuk menyederhanakan pekerjaan di src/services/ dan memastikan integritas data antar-alur, tambahkan fungsi dan trigger berikut di Supabase:   
PNG
+ 4
SQL
-- ============================================================================
-- A. TRIGGER OTOMATIS MEMBUAT PROFIL SAAT USER REGISTER DI SUPABASE AUTH
-- ============================================================================
CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS TRIGGER AS $$
BEGIN
  INSERT INTO public.profiles (id, full_name)
  VALUES (
    NEW.id,
    COALESCE(NEW.raw_user_meta_data->>'full_name', split_part(NEW.email, '@', 1))
  );
  RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

CREATE TRIGGER on_auth_user_created
  AFTER INSERT ON auth.users
  FOR EACH ROW EXECUTE FUNCTION public.handle_new_user();

-- ============================================================================
-- B. TRIGGER OTOMATIS MENCATAT BB/TB AWAL KE GROWTH_RECORDS SAAT BUAT PROFIL ANAK
-- ============================================================================
CREATE OR REPLACE FUNCTION public.seed_initial_growth_record()
RETURNS TRIGGER AS $$
DECLARE
  v_age_months NUMERIC(4,1);
BEGIN
  v_age_months := ROUND((CURRENT_DATE - NEW.birth_date) / 30.4375, 1);
  
  INSERT INTO public.growth_records (
    child_id,
    measurement_date,
    age_in_months,
    weight_kg,
    height_cm,
    needs_attention,
    insight_status,
    insight_message
  ) VALUES (
    NEW.id,
    CURRENT_DATE,
    GREATEST(v_age_months, 0),
    NEW.initial_weight_kg,
    NEW.initial_height_cm,
    FALSE,
    'normal_routine',
    'Data awal berhasil dicatat. Lanjutkan monitoring rutin.'
  );
  RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

CREATE TRIGGER on_child_profile_created
  AFTER INSERT ON public.children
  FOR EACH ROW EXECUTE FUNCTION public.seed_initial_growth_record();

-- ============================================================================
-- C. VIEW DAILY NUTRITION SUMMARY (FLOW 1 - AGREGASI NUTRISI HARIAN)
-- ============================================================================
CREATE OR REPLACE VIEW public.daily_nutrition_summaries AS
SELECT
  child_id,
  log_date,
  COUNT(id) AS total_logged_items,
  SUM((calculated_nutrition->>'calories')::NUMERIC) AS total_calories_kcal,
  SUM((calculated_nutrition->>'protein_g')::NUMERIC) AS total_protein_g,
  SUM((calculated_nutrition->>'fat_g')::NUMERIC) AS total_fat_g,
  SUM((calculated_nutrition->>'carbs_g')::NUMERIC) AS total_carbs_g
FROM public.food_logs
GROUP BY child_id, log_date;

-- ============================================================================
-- D. RPC FUNCTION UNTUK RAG SIMILARITY SEARCH (FLOW 3 - RETRIEVE KNOWLEDGE)
-- ============================================================================
CREATE OR REPLACE FUNCTION public.match_knowledge_documents(
  query_embedding VECTOR(1536),
  match_threshold FLOAT DEFAULT 0.75,
  match_count INT DEFAULT 4
)
RETURNS TABLE (
  id UUID,
  title TEXT,
  content TEXT,
  source_authority TEXT,
  validated_by TEXT,
  similarity FLOAT
)
LANGUAGE sql STABLE
AS $$
  SELECT
    kd.id,
    kd.title,
    kd.content,
    kd.source_authority,
    kd.validated_by,
    1 - (kd.embedding <=> query_embedding) AS similarity
  FROM public.knowledge_documents kd
  WHERE 1 - (kd.embedding <=> query_embedding) > match_threshold
  ORDER BY kd.embedding <=> query_embedding
  LIMIT match_count;
$$;
7. Kebijakan Keamanan (Row Level Security / RLS) & Storage
Setiap orang tua hanya diizinkan mengakses dan mengubah data profil anaknya sendiri, sedangkan tabel katalog (recipes, foods, knowledge_documents) bersifat read-only bagi pengguna terautentikasi:   
