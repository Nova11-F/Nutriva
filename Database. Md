-- Aktifkan RLS pada seluruh tabel
ALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.children ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.growth_records ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.recipes ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.saved_meal_plans ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.foods ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.food_logs ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.favorite_foods ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.knowledge_documents ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.chat_messages ENABLE ROW LEVEL SECURITY;

-- Kebijakan Tabel Pribadi Pengguna
CREATE POLICY "Users can manage own profile" ON public.profiles
  FOR ALL USING (auth.uid() = id);

CREATE POLICY "Parents can manage own children" ON public.children
  FOR ALL USING (auth.uid() = user_id);

CREATE POLICY "Parents can manage own child growth records" ON public.growth_records
  FOR ALL USING (
    EXISTS (SELECT 1 FROM public.children c WHERE c.id = growth_records.child_id AND c.user_id = auth.uid())
  );

CREATE POLICY "Parents can manage own saved meal plans" ON public.saved_meal_plans
  FOR ALL USING (
    EXISTS (SELECT 1 FROM public.children c WHERE c.id = saved_meal_plans.child_id AND c.user_id = auth.uid())
  );

CREATE POLICY "Parents can manage own child food logs" ON public.food_logs
  FOR ALL USING (
    EXISTS (SELECT 1 FROM public.children c WHERE c.id = food_logs.child_id AND c.user_id = auth.uid())
  );

CREATE POLICY "Users can manage own favorite foods" ON public.favorite_foods
  FOR ALL USING (auth.uid() = user_id);

CREATE POLICY "Users can manage own chat messages" ON public.chat_messages
  FOR ALL USING (auth.uid() = user_id);

-- Kebijakan Tabel Referensi Publik (Read-Only untuk User Terautentikasi)
CREATE POLICY "Authenticated users can read recipes" ON public.recipes
  FOR SELECT TO authenticated USING (true);

CREATE POLICY "Authenticated users can read foods" ON public.foods
  FOR SELECT TO authenticated USING (true);

CREATE POLICY "Authenticated users can read knowledge documents" ON public.knowledge_documents
  FOR SELECT TO authenticated USING (true);