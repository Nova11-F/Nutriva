# ===== Nutriva AI Service — salin ke .env (lokal) atau isi sebagai Secrets/Variables di HF Space =====
# JANGAN commit file .env. Semua secret hanya di server, tidak pernah di frontend.

# --- Lingkungan ---
# production di HF Space
APP_ENV=development
LOG_LEVEL=INFO
# default false di production
ENABLE_DOCS=true

# --- CORS: origin web Nutriva (pisahkan dengan koma, tanpa garis miring di akhir) ---
ALLOWED_ORIGINS=http://localhost:5173
# ALLOWED_ORIGIN_REGEX=^https://nutriva-[a-z0-9-]+\.vercel\.app$   # opsional, untuk preview deploy

# --- Auth: token Supabase dari user yang login ---
# 'disabled' hanya untuk lokal/test; ditolak di production
AUTH_MODE=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# anon key (public), BUKAN service_role
SUPABASE_ANON_KEY=<anon-public-key>
AUTH_CACHE_TTL_S=60

# --- Batas pemakaian ---
RATE_LIMIT_CHAT_PER_MIN=10
RATE_LIMIT_ASSESS_PER_MIN=60
MAX_CONCURRENT_LLM=4
LLM_QUEUE_WAIT_S=10

# --- LLM (secret) — Gemini (base LLM resmi Nutriva) ---
# gemini | openai_compatible | anthropic | mock
LLM_PROVIDER=gemini
# Kosongkan untuk pakai default Gemini; isi hanya bila memakai endpoint/proxy lain.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-3.5-flash-lite
# Ambil di Google AI Studio: https://aistudio.google.com/app/apikey
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048
# Gemini mendukung JSON mode (responseMimeType=application/json).
LLM_JSON_MODE=true
LLM_TIMEOUT_S=60
RAG_TOP_K=4
